# Copy this file to .env and fill in real values as you get them.
# Everything works in MOCK mode with no keys at all.

# mock = fake local placeholder assets, no external calls, free
# live = real provider calls (requires keys below)
PROVIDER_MODE=mock

DATABASE_URL=postgresql+psycopg://aividgen:aividgen@localhost:5432/aividgen

# OpenRouter powers the chat LLM (real API, works as soon as you add a key).
# If left empty, chat falls back to a scripted question flow (still works, just not "smart").
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini

# Highfield: fill these in once you share the real API docs/base URL with Claude.
# Until then PROVIDER_MODE=mock is used regardless of these.
HIGHFIELD_API_KEY=
HIGHFIELD_BASE_URL=

# Stock fallback library sources (optional, used by scripts/seed_stock_library.py)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

MAX_GENERATION_ATTEMPTS=2
CHAT_MAX_TURNS=10
