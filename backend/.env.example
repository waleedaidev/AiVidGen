# Copy to .env and fill in.
# mock = everything local | free = Pollinations image + Piper voice + local render | live = Higgsfield image+video
PROVIDER_MODE=free

DATABASE_URL=postgresql+psycopg://aividgen:aividgen@localhost:55490/aividgen
REDIS_URL=redis://localhost:56379/0
# Celery is used when a worker is running; otherwise jobs run in a local thread.
USE_CELERY=true

# LLM (script, planning, chat) via OpenRouter — cheap Chinese model. Empty key = rule-based fallbacks.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=deepseek/deepseek-v4-flash

# Higgsfield platform API (https://docs.higgsfield.ai) — images (Soul) + video (Chinese models).
HIGHFIELD_API_KEY_ID=
HIGHFIELD_API_KEY_SECRET=
# Video models: hailuo_fast | hailuo | kling_turbo | kling3_turbo  (see app/utils/model_router.py)
VIDEO_MODEL_PRIMARY=hailuo
VIDEO_MODEL_FALLBACK=kling_turbo
# higgsfield (Soul) | pollinations (free)
IMAGE_PROVIDER=higgsfield

# Piper local TTS (free). Female/male voices give characters different voices.
PIPER_BINARY_PATH=./piper_bin/piper/piper.exe
PIPER_VOICE_MODEL_PATH=./voices/en_US-lessac-medium.onnx
PIPER_FEMALE_VOICE_PATH=./voices/en_US-lessac-medium.onnx
PIPER_MALE_VOICE_PATH=./voices/en_US-ryan-medium.onnx

# Video shape + cost caps
TARGET_DURATION_SECONDS=15
MAX_SHOTS=3
MAX_CHARACTERS=3
SHOT_MAX_RETRIES=2
SHOT_CONCURRENCY=3
ASPECT_RATIO=9:16
# Optional background music: drop mp3/wav files in backend/music (filename words matched to tone).
MUSIC_DIR=music

# Human editor: when true, finished videos wait for approval in /api/admin before the user sees them.
REQUIRE_HUMAN_REVIEW=false
ADMIN_TOKEN=

# Delivery
PUBLIC_BASE_URL=http://localhost:8000
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Stock fallback library (scripts/seed_stock_library.py)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

CHAT_MAX_TURNS=10
