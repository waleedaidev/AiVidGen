# Copy this file to .env and fill in real values as you get them.
# Everything works in MOCK mode with no keys at all.

# mock = fake local placeholder assets, no external calls at all
# free  = real free providers: Pollinations (image), Piper (voice), Hugging Face (video)
# live  = Highfield (requires keys below + their API docs wired into providers/highfield.py)
PROVIDER_MODE=free

DATABASE_URL=postgresql+psycopg://aividgen:aividgen@localhost:5432/aividgen

# OpenRouter powers the chat LLM (real API, works as soon as you add a key).
# If left empty, chat falls back to a scripted question flow (still works, just not "smart").
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini

# Hugging Face: free token from https://huggingface.co/settings/tokens (no card needed).
# Powers video generation in PROVIDER_MODE=free. If empty, falls back to the mock video provider.
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_VIDEO_MODEL=damo-vilab/text-to-video-ms-1.7b

# Piper: local TTS, no key needed — just a downloaded voice model.
# Get a .onnx + .onnx.json pair from https://huggingface.co/rhasspy/piper-voices
# e.g. en_US-lessac-medium.onnx, then point this at the .onnx file.
# If empty, falls back to the silent mock audio provider.
PIPER_VOICE_MODEL_PATH=

# Highfield: fill these in once you share the real API docs/base URL with Claude.
# Only used when PROVIDER_MODE=live.
HIGHFIELD_API_KEY=
HIGHFIELD_BASE_URL=

# Stock fallback library sources (optional, used by scripts/seed_stock_library.py)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

MAX_GENERATION_ATTEMPTS=2
CHAT_MAX_TURNS=10
